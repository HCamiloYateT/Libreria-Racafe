\name{TipografiaDashboard}
\alias{tema_racafe_ggplot}
\alias{aplicar_tipografia_plotly}
\title{Tipografía corporativa para dashboards}
\description{Tema ggplot o figura Plotly con tipografía homogénea; no altera rangos, datos, unidades ni textos del gráfico.}
\usage{
tema_racafe_ggplot()
aplicar_tipografia_plotly(figura)
}
\arguments{
\item{figura}{Figura Plotly construida. Se conserva el layout y se ajusta únicamente la tipografía.}
}
\value{Objeto de presentación, cálculo o contrato reactivo descrito en los detalles de la función.}
