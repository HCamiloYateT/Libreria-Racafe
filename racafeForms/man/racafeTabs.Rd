\name{racafeTabs}
\alias{racafeTabs}
\title{Pestañas corporativas para módulos Shiny}
\usage{racafeTabs(..., id = NULL, selected = NULL, type = c("tabs", "pills"), ns = NULL)}
\arguments{
\item{...}{Paneles shiny::tabPanel.}
\item{id}{ID local opcional.}
\item{selected}{Valor del panel seleccionado.}
\item{type}{Pestañas o botones.}
\item{ns}{Namespace opcional del módulo.}
}
\description{Conserva la navegación y los eventos nativos de Shiny con colores corporativos.}
\value{Contenedor de pestañas corporativo.}
